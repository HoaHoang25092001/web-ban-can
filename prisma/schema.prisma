generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  icon        String?
  image       String?
  /// Có hiện danh mục này ở khối "Sản phẩm nổi bật" trên trang chủ không.
  /// Mặc định bật để danh mục mới tạo vẫn xuất hiện mà không phải nhớ chỉnh.
  showOnHome  Boolean   @default(true)
  /// Thứ tự hiển thị trên trang chủ: số nhỏ lên trước. Cùng số thì xếp theo tên.
  homeOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  // Trang chủ luôn lọc theo showOnHome rồi sắp theo homeOrder.
  @@index([showOnHome, homeOrder])
  @@map("categories")
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  categoryId   Int
  capacity     String?
  accuracy     String?
  price        String?
  image        String?
  images       String[] @default([]) // Gallery ảnh sản phẩm (nhiều ảnh)
  featured     Boolean  @default(false)
  dialSize     String?  // Kích thước dia
  scaleSize    String?  // Kích thước cân
  manufacturer String?  // Sản xuất
  origin       String?  // Xuất xứ
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  category     Category @relation(fields: [categoryId], references: [id])

  // Index cho các truy vấn thường dùng. Với 3.000+ sản phẩm, thiếu index thì
  // mọi lần lọc theo danh mục hay lấy sản phẩm nổi bật đều phải quét toàn bảng.
  // Kèm createdAt vì luôn sắp xếp theo ngày tạo giảm dần.
  @@index([categoryId, createdAt(sort: Desc)])
  @@index([featured, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("products")
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  excerpt   String?
  image     String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Mọi truy vấn tin tức đều lọc published rồi sắp theo ngày giảm dần.
  // Thiếu index thì phải quét toàn bảng — với 69 bài chưa nặng, nhưng sẽ chậm
  // dần khi số bài tăng, và mỗi lần quét đều tốn một vòng đi-về tới Neon.
  @@index([published, createdAt(sort: Desc)])
  @@map("news")
}

/// Trang nội dung tự tạo từ khu quản trị.
///
/// Website cũ (WordPress) có hơn 1.600 trang kiểu "Bán cân điện tử giá rẻ tại
/// Quy Nhơn" — mỗi tỉnh/dòng hàng một trang để hứng tìm kiếm Google. Bản React
/// hiện tại chỉ có 5 trang viết cứng trong code, muốn thêm một trang mới phải
/// nhờ lập trình viên sửa mã nguồn rồi triển khai lại.
///
/// Bảng này cho phép tự soạn trang ngay trên web, tự sinh đường dẫn thân thiện
/// và tự vào sitemap để Google tìm thấy (tiêu chí 1 & 9).
model Page {
  id          Int      @id @default(autoincrement())
  title       String
  /// Đường dẫn thân thiện, ví dụ "ban-can-dien-tu-tai-quy-nhon".
  /// Dùng slug thay cho id vì Google xếp hạng tốt hơn khi URL chứa từ khoá,
  /// và khách nhìn đường dẫn là đoán được nội dung.
  slug        String   @unique
  content     String
  /// Tóm tắt hiện ở danh sách trang và dùng làm mô tả dự phòng cho Google.
  excerpt     String?
  image       String?
  /// Tiêu đề và mô tả riêng cho kết quả tìm kiếm. Để trống thì lấy title và
  /// excerpt — tách riêng vì tiêu đề đẹp trên trang thường quá dài cho Google.
  metaTitle       String?
  metaDescription String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Trang công khai tra cứu theo slug; danh sách lọc published rồi sắp theo ngày.
  @@index([published, createdAt(sort: Desc)])
  @@map("pages")
}

model ContactRequest {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  product   String?
  message   String?
  status    String   @default("new")
  /// Ghi chú của nhân viên sau khi liên hệ khách: đã báo giá bao nhiêu, khách
  /// hẹn lúc nào, vì sao không chốt... Trước đây chỉ đổi được trạng thái sang
  /// "Đã xử lý" mà không lưu lại kết quả, nên người khác tiếp nhận không biết
  /// đã trao đổi những gì và dễ gọi lại trùng.
  note      String?
  /// Thời điểm chuyển sang "Đã xử lý" — dùng để đo tốc độ phản hồi khách.
  handledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  // Trang quản trị luôn lọc theo trạng thái rồi sắp xếp theo ngày gửi.
  @@index([status, createdAt(sort: Desc)])
  @@map("contact_requests")
}

/// Một lượt xem trang của khách.
///
/// Ghi ở mức thô (mỗi lượt một dòng) thay vì chỉ cộng dồn một con số: có
/// dòng chi tiết mới thống kê được theo tỉnh, theo ngày, theo trang. Bản
/// tổng hợp tính từ đây khi cần.
///
/// KHÔNG lưu địa chỉ IP đầy đủ. Theo Nghị định 13/2023/NĐ-CP, IP là dữ liệu
/// cá nhân; lưu lại kéo theo nghĩa vụ bảo vệ và thông báo mà website bán cân
/// không cần gánh. Chỉ lưu mã băm không đảo ngược được, đủ để phân biệt
/// khách này với khách khác trong ngày.
model PageView {
  id        Int      @id @default(autoincrement())
  /// Đường dẫn được xem, ví dụ "/product/3270".
  path      String
  /// Mã tỉnh/thành theo Vercel (ví dụ "SG" cho TP.HCM). Rỗng nếu không xác định.
  region    String?
  /// Tên tỉnh/thành đã dịch sang tiếng Việt, để không phải tra lại khi hiển thị.
  regionName String?
  /// Mã quốc gia hai chữ, ví dụ "VN".
  country   String?
  /// Mã băm của IP + ngày, dùng để đếm "khách khác nhau" mà không lưu IP.
  /// Đổi mỗi ngày nên không theo dõi được một người qua nhiều ngày.
  visitorHash String
  createdAt DateTime @default(now())

  // Thống kê luôn lọc theo khoảng thời gian, rồi gom theo tỉnh hoặc đếm tổng.
  @@index([createdAt(sort: Desc)])
  @@index([region, createdAt(sort: Desc)])
  @@index([visitorHash, createdAt(sort: Desc)])
  @@map("page_views")
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}


// ─────────────────────────────────────────────────────────────────────────────
// PHẦN CÂN ĐIỆN TỬ (/can-dien-tu)
//
// Khu vực riêng cho KHÁCH HÀNG đã mua cân: họ đăng nhập để ghi lại số liệu cân
// hàng của mình. Hoàn toàn tách khỏi phần bán hàng của website.
//
// Nguyên tắc xuyên suốt: mỗi bản ghi gắn với đúng một tài khoản khách, và mọi
// truy vấn đều lọc theo tài khoản đang đăng nhập. Khách A không có đường nào
// nhìn thấy dữ liệu của khách B, kể cả khi tự sửa địa chỉ trên trình duyệt.
//
// Tên bảng đều có tiền tố `scale_` để không đụng với bảng của website: dự án
// gốc đặt tên `users` và `products`, trùng với bảng sẵn có.
// ─────────────────────────────────────────────────────────────────────────────

/// Tài khoản khách hàng dùng phần cân điện tử.
///
/// Do quản trị viên website cấp — khách KHÔNG tự đăng ký được. Chủ shop tạo
/// tài khoản, đặt lại mật khẩu và khoá khi hết hạn dịch vụ, nhưng không đọc
/// được số liệu cân hàng của khách (bí mật kinh doanh của họ).
model ScaleUser {
  id        Int      @id @default(autoincrement())
  /// Tên đăng nhập, khách dùng để vào hệ thống.
  username  String   @unique
  /// Mật khẩu đã băm bằng bcrypt. KHÔNG bao giờ lưu dạng chữ thường.
  password  String
  /// Tên khách hàng hoặc tên công ty, hiện trên giao diện.
  fullName  String
  /// Số điện thoại liên hệ, để chủ shop gọi khi cần hỗ trợ.
  phone     String?
  /// Ghi chú nội bộ: đã mua cân gì, hết hạn khi nào...
  note      String?
  /// Khoá tài khoản mà không xoá dữ liệu — dùng khi khách hết hạn dịch vụ.
  isActive  Boolean  @default(true)
  /// Lần đăng nhập gần nhất, giúp biết tài khoản nào còn dùng thật.
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ScaleProduct[]
  records  WeighingRecord[]

  @@index([isActive, createdAt(sort: Desc)])
  @@map("scale_users")
}

/// Danh mục mặt hàng của riêng từng khách.
///
/// Mã hàng chỉ cần duy nhất TRONG PHẠM VI một khách: hai công ty khác nhau
/// hoàn toàn có thể cùng dùng mã "SP001" cho hai mặt hàng khác nhau.
model ScaleProduct {
  id     Int    @id @default(autoincrement())
  code   String
  name   String
  userId Int

  user    ScaleUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  records WeighingRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, code])
  @@index([userId, name])
  @@map("scale_products")
}

/// Một lần cân hàng.
///
/// Lưu kèm tên và mã hàng dưới dạng chữ (không chỉ khoá ngoại): khách đổi tên
/// mặt hàng hay xoá nó khỏi danh mục thì bản ghi cũ vẫn giữ nguyên thông tin
/// tại thời điểm cân — sổ sách không được thay đổi theo thời gian.
model WeighingRecord {
  id           Int      @id @default(autoincrement())
  productCode  String
  productName  String
  weight       Float
  unit         String   @default("kg")
  /// Người trực tiếp cân, khách tự nhập. Hữu ích khi một công ty có nhiều
  /// người dùng chung một tài khoản.
  employeeName String?
  note         String?
  weighedAt    DateTime @default(now())

  userId    Int
  user      ScaleUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Liên kết tới danh mục nếu mặt hàng còn tồn tại; xoá mặt hàng thì để trống
  /// chứ không xoá bản ghi cân.
  productId Int?
  product   ScaleProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Mọi truy vấn đều bắt đầu bằng "của tài khoản này", rồi mới sắp theo thời gian.
  @@index([userId, weighedAt(sort: Desc)])
  @@index([userId, productCode])
  @@map("weighing_records")
}
