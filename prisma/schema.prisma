generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  icon        String?
  image       String?
  /// Có hiện danh mục này ở khối "Sản phẩm nổi bật" trên trang chủ không.
  /// Mặc định bật để danh mục mới tạo vẫn xuất hiện mà không phải nhớ chỉnh.
  showOnHome  Boolean   @default(true)
  /// Thứ tự hiển thị trên trang chủ: số nhỏ lên trước. Cùng số thì xếp theo tên.
  homeOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  // Trang chủ luôn lọc theo showOnHome rồi sắp theo homeOrder.
  @@index([showOnHome, homeOrder])
  @@map("categories")
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  categoryId   Int
  capacity     String?
  accuracy     String?
  price        String?
  image        String?
  images       String[] @default([]) // Gallery ảnh sản phẩm (nhiều ảnh)
  featured     Boolean  @default(false)
  dialSize     String?  // Kích thước dia
  scaleSize    String?  // Kích thước cân
  manufacturer String?  // Sản xuất
  origin       String?  // Xuất xứ
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  category     Category @relation(fields: [categoryId], references: [id])

  // Index cho các truy vấn thường dùng. Với 3.000+ sản phẩm, thiếu index thì
  // mọi lần lọc theo danh mục hay lấy sản phẩm nổi bật đều phải quét toàn bảng.
  // Kèm createdAt vì luôn sắp xếp theo ngày tạo giảm dần.
  @@index([categoryId, createdAt(sort: Desc)])
  @@index([featured, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("products")
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  excerpt   String?
  image     String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Mọi truy vấn tin tức đều lọc published rồi sắp theo ngày giảm dần.
  // Thiếu index thì phải quét toàn bảng — với 69 bài chưa nặng, nhưng sẽ chậm
  // dần khi số bài tăng, và mỗi lần quét đều tốn một vòng đi-về tới Neon.
  @@index([published, createdAt(sort: Desc)])
  @@map("news")
}

/// Trang nội dung tự tạo từ khu quản trị.
///
/// Website cũ (WordPress) có hơn 1.600 trang kiểu "Bán cân điện tử giá rẻ tại
/// Quy Nhơn" — mỗi tỉnh/dòng hàng một trang để hứng tìm kiếm Google. Bản React
/// hiện tại chỉ có 5 trang viết cứng trong code, muốn thêm một trang mới phải
/// nhờ lập trình viên sửa mã nguồn rồi triển khai lại.
///
/// Bảng này cho phép tự soạn trang ngay trên web, tự sinh đường dẫn thân thiện
/// và tự vào sitemap để Google tìm thấy (tiêu chí 1 & 9).
model Page {
  id          Int      @id @default(autoincrement())
  title       String
  /// Đường dẫn thân thiện, ví dụ "ban-can-dien-tu-tai-quy-nhon".
  /// Dùng slug thay cho id vì Google xếp hạng tốt hơn khi URL chứa từ khoá,
  /// và khách nhìn đường dẫn là đoán được nội dung.
  slug        String   @unique
  content     String
  /// Tóm tắt hiện ở danh sách trang và dùng làm mô tả dự phòng cho Google.
  excerpt     String?
  image       String?
  /// Tiêu đề và mô tả riêng cho kết quả tìm kiếm. Để trống thì lấy title và
  /// excerpt — tách riêng vì tiêu đề đẹp trên trang thường quá dài cho Google.
  metaTitle       String?
  metaDescription String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Trang công khai tra cứu theo slug; danh sách lọc published rồi sắp theo ngày.
  @@index([published, createdAt(sort: Desc)])
  @@map("pages")
}

model ContactRequest {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  product   String?
  message   String?
  status    String   @default("new")
  /// Ghi chú của nhân viên sau khi liên hệ khách: đã báo giá bao nhiêu, khách
  /// hẹn lúc nào, vì sao không chốt... Trước đây chỉ đổi được trạng thái sang
  /// "Đã xử lý" mà không lưu lại kết quả, nên người khác tiếp nhận không biết
  /// đã trao đổi những gì và dễ gọi lại trùng.
  note      String?
  /// Thời điểm chuyển sang "Đã xử lý" — dùng để đo tốc độ phản hồi khách.
  handledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  // Trang quản trị luôn lọc theo trạng thái rồi sắp xếp theo ngày gửi.
  @@index([status, createdAt(sort: Desc)])
  @@map("contact_requests")
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

